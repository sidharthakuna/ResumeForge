# =============================================================================
# Environment configuration template for ResumeBuilder backend.
# Copy this file as .env and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit the real .env file — it's already in .gitignore.
# =============================================================================

# --- Database ---
DB_USERNAME=resumebuilder
DB_PASSWORD=your_db_password_here

# --- JWT ---
# Generate a secure Base64-encoded secret (at least 256 bits for HS256):
#   openssl rand -base64 32
JWT_SECRET=your_base64_encoded_secret_here
JWT_EXPIRATION_MS=86400000

# --- Storage (optional, for S3/R2 deployment) ---
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=auto
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com

# --- CORS (optional, for deployment) ---
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# --- AI & Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_ENABLED=true
GEMINI_TIMEOUT=30000
AI_REQUEST_LIMIT=10
AI_REQUEST_REFILL_HOURS=1

# --- Keep Alive (optional, for Render free tier self-pinging) ---
# KEEPALIVE_ENABLED=true
# RENDER_EXTERNAL_URL=https://your-backend-app.onrender.com

