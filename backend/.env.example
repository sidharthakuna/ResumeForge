# =============================================================================
# Environment configuration template for ResumeBuilder backend.
# Copy this file as .env and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit the real .env file — it's already in .gitignore.
# =============================================================================

# --- Database ---
DB_USERNAME=resumebuilder
DB_PASSWORD=your_db_password_here

# --- JWT ---
JWT_SECRET=your_base64_encoded_secret_here
JWT_EXPIRATION_MS=86400000

# --- Email & SMTP (Gmail or any SMTP provider for OTP verification) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password

# --- Google OAuth2 Authentication ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- AI & Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_ENABLED=true
GEMINI_TIMEOUT=30000
AI_REQUEST_LIMIT=10
AI_REQUEST_REFILL_HOURS=1

# --- CORS (optional, for deployment) ---
# CORS_ALLOWED_ORIGINS=https://resume-forge-fawn.vercel.app

# --- Keep Alive (optional, for Render free tier self-pinging) ---
# KEEPALIVE_ENABLED=true
# RENDER_EXTERNAL_URL=https://your-backend-app.onrender.com
